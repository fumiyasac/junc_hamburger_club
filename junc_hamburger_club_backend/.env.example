MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=junc_hamburger
MYSQL_USER=junc_user
MYSQL_PASSWORD=junc_password
JWT_SECRET=your_jwt_secret_here_change_in_production
NODE_ENV=development

# ─── 管理画面ログイン (admin-api) ───────────────────────────────────────
# admin 認証は DB ではなく env ベース。bcrypt ハッシュを設定する。
# 下記はパスワード "admin1234" 用のハッシュ (開発用)。本番では必ず差し替える。
# 別パスワードの bcrypt ハッシュを生成するには:
#   docker exec junc_user_api node -e "console.log(require('bcryptjs').hashSync('<パスワード>', 10))"
ADMIN_EMAIL=admin@junc-hamburger.com
ADMIN_PASSWORD_HASH=$$2a$$10$$g2cQdkbniWx.GQs0Zh1TTuyFWnVVp.URkONvgrLHzgH7LtYfRVZA.
