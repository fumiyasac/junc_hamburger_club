FROM node:20-alpine AS builder

WORKDIR /app

COPY user-api/package*.json ./
RUN npm ci

COPY user-api/ .
RUN npm run build

# ─── production stage ───────────────────────────────
FROM node:20-alpine AS production

WORKDIR /app

COPY user-api/package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/dist ./dist

ENV NODE_ENV=production

EXPOSE 3000
CMD ["node", "dist/server.js"]
